{
  "manifest_version": 3,
  "name": "SubsPlease qBittorrent RSS Manager",
  "version": "1.1.0",
  "description": "Add and remove exact-title SubsPlease RSS download rules from the schedule.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://subsplease.org/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SubsPlease RSS Manager"
  },
  "content_scripts": [
    {
      "matches": [
        "https://subsplease.org/schedule*"
      ],
      "js": [
        "content-utils.js",
        "content-artwork.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
